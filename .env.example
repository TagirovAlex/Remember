# Секреты и окружение. Заполни реальные значения в .env — этот файл не коммитить.

# Telegram-бот. Пусто = бот не запускается (только web).
BOT_TOKEN=

# Прокси к Telegram (SOCKS5) настраивается в интерфейсе /settings (хранится в БД):
# proxy_enabled / proxy_host / proxy_port / proxy_user / proxy_password.
# Пароль прокси в вебе не отображается.

# Пароль админа веб-интерфейса. Используется при первом запуске (запись в БД),
# затем пароль меняется в /settings.
ADMIN_PASSWORD=

# Ключ подписи сессий. Если пусто — генерируется при первом запуске
# и сохраняется в настройках.
SECRET_KEY=

# Путь к SQLite-файлу.
DATABASE_PATH=data/remember.db

# Адрес и порт, которые слушает приложение (по умолчанию 0.0.0.0:8000).
# Если 8000 занят другим сервисом — задайте свой порт и направьте
# reverse-proxy (Caddy/nginx) на него.
HOST=0.0.0.0
PORT=8000

# Часовой пояс по умолчанию (перезаписывается настройкой tz в БД).
TZ=Europe/Moscow